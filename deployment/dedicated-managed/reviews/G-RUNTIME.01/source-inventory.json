  "originalConditions": [
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "DB-001 / condition 1",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Maintain a separate database and separate runtime credentials for each owning service within each Cell. A shared PostgreSQL cluster does not permit shared cross-service databases or runtime privileges.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 367
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "DB-001 / condition 2",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Preserve separation between Runtime and Migration roles and enforce least-privilege permissions.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 368
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "DB-001 / condition 3",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Prohibit administrative access, privilege escalation, and RLS bypass by Runtime roles.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 369
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "DB-001 / condition 4",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Require validated Tenant Context and applicable RLS controls for both read and write operations.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 370
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "DB-001 / condition 5",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Preserve credential isolation and prohibit Operations Agent access to database secrets.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 371
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "DB-001 / condition 6",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Require real PostgreSQL, role, RLS, Connection Pool, and cross-service/Cell unauthorized-access verification before Runtime Isolation acceptance.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 372
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "DB-001 / condition 7",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Keep OD-012, OD-013, and OD-014 open until independently dispositioned. Do not select the production database topology at this stage.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 373
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "RT-002 / condition 1",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Restrict the Reference Environment to one synthetic Tenant and one Dedicated Cell.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 387
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "RT-002 / condition 2",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Preserve separation of service Containers, Configuration, Runtime Identities, and network boundaries.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 388
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "RT-002 / condition 3",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Prohibit Privileged Containers, unrestricted Docker Socket access, and unrestricted Host administration.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 389
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "RT-002 / condition 4",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Enforce Controller and Agent authority restrictions in accordance with OA-003.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 390
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "RT-002 / condition 5",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Preserve database and credential isolation in accordance with DB-001 and CL-004.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 391
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "RT-002 / condition 6",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Require separately authorized verification of Network Isolation, Readiness, Service Lifecycle, Recovery, and cleanup limited to owned resources.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 392
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "OA-003 / condition 1",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Maintain independent Controller and Agent identities and separate Authorization and Execution responsibilities.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 408
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "OA-003 / condition 2",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Validate authorization at request admission and immediately before consequential execution.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 409
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "OA-003 / condition 3",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Bind authorization to the exact Operation, Parameters, Target, Deployment/Cell, Resource Version, and immutable Digest.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 410
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "OA-003 / condition 4",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Enforce Allowlisting scoped to operation type, resource, and configuration.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 411
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "OA-003 / condition 5",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Prohibit arbitrary Shell execution, unrestricted Docker Socket access, broad Host administrative privileges, and access to database secrets or Tenant business data.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 412
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "OA-003 / condition 6",
      "sourceGitBlob": "a346ac1d19b9d2f12a933790b1c77e092544160e",
      "originalRequirement": "Enforce Replay, Concurrency, Conflict, and Crash Recovery safeguards.",
      "sourceDocument": "architecture/adr/016-dedicated-managed-reference-architecture.md",
      "sourceLine": 413
    },
    {
      "sourceRevision": "094c966de745285bd5a8d1975312eb06d930d4a8",
      "id": "OA-003 / condition 7",
