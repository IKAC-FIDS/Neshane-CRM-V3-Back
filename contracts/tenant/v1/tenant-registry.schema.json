{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neshane:tenant:registry:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "tenantId",
    "registryVersion",
    "registryStatus",
    "authorityMetadata"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "registryVersion": {
      "type": "integer",
      "minimum": 1
    },
    "registryStatus": {
      "enum": [
        "ACTIVE",
        "TOMBSTONED"
      ]
    },
    "authorityMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentProfile",
        "authorityScope",
        "authorityKind",
        "authorityRef",
        "provenanceVersion",
        "issuedAt"
      ],
      "properties": {
        "deploymentProfile": {
          "enum": [
            "SHARED_SAAS",
            "DEDICATED_MANAGED",
            "DEDICATED_SOVEREIGN"
          ]
        },
        "authorityScope": {
          "const": "REGISTRY"
        },
        "authorityKind": {
          "enum": [
            "PROVIDER_TENANT_REGISTRY_AUTHORITY",
            "GLOBAL_MANAGED_TENANT_REGISTRY_AUTHORITY",
            "SOVEREIGN_TENANT_REGISTRY_AUTHORITY"
          ]
        },
        "authorityRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sourceDeploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provenanceVersion": {
          "type": "integer",
          "minimum": 1
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "deploymentProfile": {
                "const": "SHARED_SAAS"
              },
              "authorityScope": {
                "const": "REGISTRY"
              }
            },
            "required": [
              "deploymentProfile",
              "authorityScope"
            ]
          },
          "then": {
            "properties": {
              "authorityKind": {
                "const": "PROVIDER_TENANT_REGISTRY_AUTHORITY"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "deploymentProfile": {
                "const": "DEDICATED_MANAGED"
              },
              "authorityScope": {
                "const": "REGISTRY"
              }
            },
            "required": [
              "deploymentProfile",
              "authorityScope"
            ]
          },
          "then": {
            "properties": {
              "authorityKind": {
                "const": "GLOBAL_MANAGED_TENANT_REGISTRY_AUTHORITY"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "deploymentProfile": {
                "const": "DEDICATED_SOVEREIGN"
              },
              "authorityScope": {
                "const": "REGISTRY"
              }
            },
            "required": [
              "deploymentProfile",
              "authorityScope"
            ]
          },
          "then": {
            "properties": {
              "authorityKind": {
                "const": "SOVEREIGN_TENANT_REGISTRY_AUTHORITY"
              }
            }
          }
        }
      ]
    }
  }
}
